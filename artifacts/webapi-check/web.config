<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS: ASPNETCORE_ENVIRONMENT=Production so appsettings.Production.json is used
  (NOT Development — that file still points at your local desktop DB).
  stdoutLogEnabled=true writes crash reason to .\logs\stdout_*.log when you get 500.30.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\PakSuzuki.WebApi.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
